.barra-editor {
  background: var(--noche);
  color: var(--luz);
  padding: 1rem 0;
  border-bottom: 1px solid var(--noche-borde);
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
}

.btn-volver {
  color: var(--cian);
  text-decoration: none;
  font-weight: 600;
}

.panel-main {
  margin-top: 2rem;
  display: grid;
  gap: 2rem;
  padding-bottom: 4rem;
}

.card-panel {
  background: var(--blanco);
  border: 1px solid var(--borde);
  border-radius: var(--radio);
  padding: 1.5rem;
}

.txt-sub {
  color: var(--tinta-2);
  font-size: 0.9rem;
  margin: 0.5rem 0 1rem;
}

.input-group {
  display: flex;
  gap: 0.5rem;
  max-width: 500px;
}

.input-group input {
  flex: 1;
  padding: 0.6rem;
  border-radius: 8px;
  border: 1px solid var(--borde);
}

.status-txt {
  display: block;
  margin-top: 0.5rem;
  font-weight: 600;
}

.editor-grid {
  display: grid;
  gap: 1rem;
  margin-top: 1.5rem;
}

.prod-item-row {
  display: flex;
  gap: 1rem;
  align-items: center;
  padding: 1rem;
  border: 1px solid var(--borde);
  border-radius: var(--radio-s);
  background: var(--papel);
  flex-wrap: wrap;
}

.prod-item-row input, .prod-item-row select {
  padding: 0.5rem;
  border-radius: 6px;
  border: 1px solid var(--borde);
}

.prod-item-row .inp-nombre { flex: 2; min-width: 180px; }
.prod-item-row .inp-precio { width: 90px; }
