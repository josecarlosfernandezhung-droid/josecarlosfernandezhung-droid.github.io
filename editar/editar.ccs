body.papel {
  background: var(--papel);
  color: var(--tinta);
  font-family: var(--f-texto);
  margin: 0;
  padding-bottom: 3rem;
}

.barra-editor {
  background: var(--noche);
  color: var(--luz);
  padding: 0.8rem 1rem;
  border-bottom: 1px solid var(--noche-borde);
  position: sticky;
  top: 0;
  z-index: 50;
}

.barra-editor .contenedor {
  display: flex;
  justify-content: space-between;
  align-items: center;
  max-width: 800px;
  margin: 0 auto;
  gap: 0.5rem;
}

.barra-editor h1 {
  font-size: 1rem;
  margin: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.btn-volver {
  color: var(--cian);
  text-decoration: none;
  font-weight: 600;
  font-size: 0.9rem;
}

.panel-main {
  max-width: 800px;
  margin: 1.5rem auto;
  padding: 0 1rem;
  display: grid;
  gap: 1.5rem;
}

.card-panel {
  background: var(--blanco);
  border: 1px solid var(--borde);
  border-radius: var(--radio);
  padding: 1.2rem;
  box-shadow: var(--sombra);
}

.card-panel h2 {
  font-size: 1.2rem;
  margin-bottom: 0.3rem;
}

.txt-sub {
  color: var(--tinta-2);
  font-size: 0.85rem;
  margin-bottom: 1rem;
  line-height: 1.4;
}

.input-group {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.input-group input {
  flex: 1;
  min-width: 200px;
  padding: 0.7rem;
  border-radius: 8px;
  border: 1px solid var(--borde);
  font-size: 0.95rem;
}

.status-txt {
  display: block;
  margin-top: 0.6rem;
  font-weight: 600;
  font-size: 0.9rem;
}

.editor-grid {
  display: grid;
  gap: 1rem;
  margin-top: 1rem;
}

.prod-item-row {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0.6rem;
  padding: 1rem;
  border: 1px solid var(--borde);
  border-radius: var(--radio-s);
  background: var(--papel);
}

@media (min-width: 560px) {
  .prod-item-row {
    grid-template-columns: 2fr 100px 140px auto;
    align-items: center;
  }
  .barra-editor h1 { font-size: 1.2rem; }
}

.prod-item-row input, .prod-item-row select {
  padding: 0.6rem;
  border-radius: 6px;
  border: 1px solid var(--borde);
  background: #fff;
  font-size: 0.95rem;
  width: 100%;
}
